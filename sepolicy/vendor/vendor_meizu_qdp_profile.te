type vendor_meizu_qdp_profile, domain;
type vendor_meizu_qdp_profile_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_meizu_qdp_profile)

allow vendor_meizu_qdp_profile self:qipcrtr_socket create_socket_perms_no_ioctl;
allowxperm vendor_meizu_qdp_profile self:qipcrtr_socket ioctl msm_sock_qrtr_ioctls;
