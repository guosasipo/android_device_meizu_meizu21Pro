type hal_meizu_sensor_aux_default, domain;
hal_server_domain(hal_meizu_sensor_aux_default, hal_meizu_sensor_aux)

type hal_meizu_sensor_aux_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_meizu_sensor_aux_default)

allow hal_meizu_sensor_aux_default mnt_vendor_file:dir search;
allow hal_meizu_sensor_aux_default vendor_persist_sensors_file:dir search;
allow hal_meizu_sensor_aux_default vendor_persist_sensors_file:file r_file_perms;
allow hal_meizu_sensor_aux_default vendor_sysfs_meizu_cpu_temp:file r_file_perms;
r_dir_file(hal_meizu_sensor_aux_default, vendor_sysfs_graphics)

get_prop(hal_meizu_sensor_aux_default, surfaceflinger_color_prop)
get_prop(hal_meizu_sensor_aux_default, vendor_sensors_prop)

allow hal_meizu_sensor_aux_default self:{ socket qipcrtr_socket } create_socket_perms;
allowxperm hal_meizu_sensor_aux_default self:{ socket qipcrtr_socket } ioctl msm_sock_ipc_ioctls;
