# Audio
audio.sys.noisy.broadcast.delay=600
audio.sys.offload.pstimeout.secs=3

# Camera
ro.vendor.camera.no_vts=1

# Charger
ro.charger.enable_suspend=1

# CNE
persist.vendor.cne.feature=1

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Media
media.settings.xml=/vendor/etc/media_profiles_pineapple.xml
media.stagefright.thumbnail.prefer_hw_codecs=true

# Meizu product identity
ro.product.mobile.name=m2481
ro.product.marketname=Meizu 21 Pro

# NFC
ro.nfc.port=I2C

# QCC
ro.vendor.qti.va_aosp.support=1

# Radio
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
ro.telephony.default_network=26,26

# Sensors
persist.vendor.sensors.enable.mag_filter=true

# SSR
persist.vendor.ssr.enable_ramdumps=1

# WiFi display
persist.sys.wfd.virtual=0

# WLAN
ro.hardware.wlan.chip=kiwi_v2
ro.hardware.wlan.dbs=2
ro.hardware.wlan.mimo=1
ro.hardware.wlan.vendor=qcom

# Zygote
persist.device_config.runtime_native.usap_pool_enabled=true
